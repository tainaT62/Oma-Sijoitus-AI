# ─── Binance API ─────────────────────────────────────────────
# Luo API-avain: https://www.binance.com/fi/my/settings/api-management
# TÄRKEÄÄ: Älä anna kaupankäyntioikeuksia vielä - vain luku riittää!
BINANCE_API_KEY=avaimesi_tähän
BINANCE_SECRET_KEY=salaisavaimesi_tähän

# Testnet (aseta true, jos haluat testata ilman oikeaa rahaa)
BINANCE_TESTNET=false

# ─── OpenAI API (tuleva ominaisuus) ──────────────────────────
OPENAI_API_KEY=openai_avaimesi_tähän
OPENAI_MODEL=gpt-4o

# ─── Flask ───────────────────────────────────────────────────
# PAKOLLINEN. Sovellus ei käynnisty ilman tätä eikä oletusarvolla.
# Luo arvo:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# EI SAA olla true tuotannossa – avaa Werkzeugin debuggerin (etäajo).
FLASK_DEBUG=false
# PORT ja HOST koskevat vain paikallista kehityspalvelinta (python app.py).
# Tuotannossa osoite tulee GUNICORN_BIND-muuttujasta.
PORT=5000
HOST=0.0.0.0

# ─── Gunicorn (tuotanto) ─────────────────────────────────────
# Vain loopback: sovelluksessa ei ole autentikaatiota.
GUNICORN_BIND=127.0.0.1:5000
# Lue deploy/README.md ennen kuin kasvatat workereiden määrää.
GUNICORN_WORKERS=1
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=120

# ─── Taustascheduler ─────────────────────────────────────────
# Käynnistyy aina vain yhdessä prosessissa (tiedostolukko).
ENABLE_SCHEDULER=true

# ─── Autentikaatio ───────────────────────────────────────────
# PAKOLLINEN. Salasanan TIIVISTE – ei koskaan selkotekstinen salasana.
# Luo tiiviste (kysyy salasanan, ei näy komentohistoriassa):
#   python -c "from werkzeug.security import generate_password_hash as g; \
#              import getpass; print(g(getpass.getpass()))"
APP_PASSWORD_HASH=

# Istunnon elinikä tunteina.
SESSION_LIFETIME_HOURS=12

# Eväste vain HTTPS:n yli. Pidä true tuotannossa.
# Aseta false VAIN paikalliseen HTTP-testaukseen – muuten kirjautuminen
# ei toimi ennen kuin TLS on käytössä (Phase 3C).
SESSION_COOKIE_SECURE=true

# Kirjautumisyritysten rajoitus.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ─── Käänteisproxy ───────────────────────────────────────────
# Luotettujen proxyjen määrä sovelluksen edessä.
#   0 = ei proxya (oletus)
#   1 = Nginx samalla koneella
# VAROITUS: arvo 1 ilman todellista proxya antaa kenen tahansa väärentää
# X-Forwarded-For-otsakkeen ja kiertää kirjautumisrajoituksen.
TRUSTED_PROXY_COUNT=0

# ─── Sovelluksen asetukset ────────────────────────────────────
# Pienin USDT-arvo, joka näytetään salkussa
MIN_BALANCE_USDT=0.01
# Välimuistin elinaika sekunteina
CACHE_TTL_SECONDS=60

# ─── Tulevat ominaisuudet ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
